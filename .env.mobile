# Build-time settings for `npm run build:mobile` (the Capacitor app). These
# are public addresses, not secrets.
VITE_API_BASE=https://joseffsmith.uk/contract-whist/api
VITE_PUBLIC_URL=https://joseffsmith.uk/contract-whist
# Platforms whose app can use the site's passkeys: the site's association file
# must name the app (APPLE_TEAM_ID / ANDROID_CERT_SHA256 on the server). Add
# android once ANDROID_CERT_SHA256 is set.
VITE_NATIVE_PASSKEYS=ios
